# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local PostgreSQL (the same string is used at runtime and by `prisma migrate`)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cc_outreach

# Auth (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
# Seed script only (npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Added in later phases (uncomment as each phase lands):
# SESSION_COOKIE_DOMAIN=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_REPLY_TO=
# APIFY_TOKEN=
# WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
